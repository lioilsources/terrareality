---
import '../styles/global.css';
import { Logo } from '@terra/ui';

interface Props {
  title: string;
  description: string;
  lang: 'cs' | 'en';
  altHref: string;
  altLabel: string;
}
const { title, description, lang, altHref, altLabel } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'cs' ? 'en' : 'cs'} href={new URL(altHref, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="border-b border-[var(--border)] bg-[var(--surface)]">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href={lang === 'cs' ? '/' : '/en/'}><Logo /></a>
        <a href={altHref} class="text-sm text-[var(--muted)] hover:text-[var(--text)]">{altLabel}</a>
      </div>
    </header>
    <main class="mx-auto max-w-6xl px-4 py-12">
      <slot />
    </main>
  </body>
</html>
