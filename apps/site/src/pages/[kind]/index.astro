---
import KindIndex from '../../components/KindIndex.astro';
import { kindsByLang, localityPages } from '../../lib/localities';

export async function getStaticPaths() {
  const out = [];
  for (const kindSlug of Object.keys(kindsByLang.cs)) {
    out.push({ params: { kind: kindSlug }, props: { pages: await localityPages('cs', kindSlug) } });
  }
  return out;
}
const { kind } = Astro.params as { kind: string };
const { pages } = Astro.props;
---

<KindIndex lang="cs" kindSlug={kind} pages={pages} />
