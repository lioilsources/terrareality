---
import LocalityPage from '../../components/LocalityPage.astro';
import { kindsByLang, localityPages } from '../../lib/localities';

// Prague-area pages always; other municipalities when the api has listings (rebuilt daily).
export async function getStaticPaths() {
  const out = [];
  for (const kindSlug of Object.keys(kindsByLang.cs)) {
    for (const page of await localityPages('cs', kindSlug)) {
      out.push({ params: { kind: kindSlug, obec: page.slug }, props: { page } });
    }
  }
  return out;
}
const { kind } = Astro.params as { kind: string };
const { page } = Astro.props;
---

<LocalityPage lang="cs" kindSlug={kind} page={page} />
