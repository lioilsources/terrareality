# Copy to .env (git-ignored). `make dev` loads it. Values below match infra/dev.

# --- Go api / worker ---
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://terra:terra@localhost:5433/terra?sslmode=disable
TEST_DATABASE_URL=postgres://terra:terra@localhost:5433/terra_test?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=text
MIGRATE_ON_START=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
VISION_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:4321
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM via AiStack gateway on DGX Spark (OpenAI-compatible) ---
# Empty = mock mode (everything works without a GPU).
# LAN: http://192.168.88.66:8080/v1   public: https://llm.ol1n.com/v1
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=terra
EMBEDDINGS_MODEL=terra-embed
VISION_MODEL=terra-vision

# --- Web (SvelteKit server) ---
API_URL=http://localhost:8080
# --- Astro site ---
PUBLIC_APP_URL=http://localhost:5173
