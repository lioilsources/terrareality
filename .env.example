# Copy to .env (git-ignored). `make dev` loads it. Values below match infra/dev.

# --- Go api / worker ---
APP_ENV=dev
HTTP_ADDR=:8080
DATABASE_URL=postgres://terra:terra@localhost:5433/terra?sslmode=disable
TEST_DATABASE_URL=postgres://terra:terra@localhost:5433/terra_test?sslmode=disable
LOG_LEVEL=info
LOG_FORMAT=text
MIGRATE_ON_START=true
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-centrifugo-api-key
# Must match client.token.hmac_secret_key in infra/dev/centrifugo/config.json (dev default).
# CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
VISION_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:4321

# --- Identity (M1) ---
# Required outside dev/test, at least 32 characters (seals TOTP secrets).
# APP_SECRET_KEY=
WEB_BASE_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080
OIDC_REDIRECT_ALLOWLIST=http://localhost:5173/auth/,http://localhost:4173/auth/,terra://auth/
# Local mock IdP for Google, Apple and BankID; real providers win when configured.
MOCK_IDP=true
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID= / APPLE_CLIENT_SECRET=   (pre-generated client secret JWT)
# BANKID_ISSUER=https://oidc.sandbox.bankid.cz/ / BANKID_CLIENT_ID= / BANKID_CLIENT_SECRET=
STAFF_REQUIRE_MFA=false
AUTH_RATE_BURST=200
GDPR_ERASURE_GRACE=720h

# --- Delivery: Mailpit in dev (http://localhost:8025); SMS mock lands there too ---
SMTP_ADDR=localhost:1025
MAIL_FROM=no-reply@terrareality.cz
SMS_PROVIDER=mock

# --- Object storage (SeaweedFS S3 in dev) ---
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=terra
S3_SECRET_KEY=terra-dev-secret
S3_BUCKET=terra
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM via AiStack gateway on DGX Spark (OpenAI-compatible) ---
# Empty = mock mode (everything works without a GPU).
# LAN only: http://<spark-lan-ip>:8080/v1 (AiStack LiteLLM). LLM routes run 13:00-07:00, max 4 parallel
# requests; batch jobs must be announced (infra/spark/README.md).
LLM_BASE_URL=
LLM_API_KEY=not-needed
LLM_MODEL=openclaw-default
EMBEDDINGS_MODEL=
VISION_MODEL=

# --- Catalog (M2) ---
# Signed variants; dev values match infra/dev/docker-compose.yml.
IMGPROXY_URL=http://localhost:8081
# IMGPROXY_KEY= / IMGPROXY_SALT=  (hex, required outside dev)
# CLAMAV_ADDR=localhost:3310   (empty = uploads are not scanned)
# FEATURE_FLAGS=-ai.text       (comma list; ai.attributes, ai.text, ai.vision on by default)
SEED_RUIAN_SAMPLE=true

# --- Web (SvelteKit server) ---
API_URL=http://localhost:8080
# Search map basemap (MapLibre style URL)
# MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# --- Astro site ---
PUBLIC_APP_URL=http://localhost:5173

# --- Messaging (M4) ---
# Push/e-mail only when a message is still unread after this delay.
MESSAGE_NOTIFY_DELAY=20s
# mock = pushes appear in Mailpit as push+<user>@push.terra.local; log; fcm (needs FCM_CREDENTIALS_FILE).
PUSH_PROVIDER=mock
# FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
# WEBPUSH_SUBJECT=mailto:podpora@terrareality.cz

# --- Applications (M5) ---
# mock in dev/test; live = public ISIR web service of the Ministry of Justice.
ISIR_MODE=mock

# --- Leasing (M6) ---
TYPST_BIN=typst
# true once the customer's lawyer reviewed packages/attributes/templates (removes the DRAFT watermark)
LEASE_TEMPLATES_REVIEWED=false
# mock (dev) | gocardless (needs GOCARDLESS_SECRET_ID / GOCARDLESS_SECRET_KEY)
BANK_PROVIDER=mock
