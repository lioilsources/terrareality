# One file per stack on JODA, next to docker-compose.yml: .env.qa and .env.prod (git-ignored,
# chmod 600). `make deploy PROFILE=qa|prod` (scripts/joda.sh) runs project terra-<profile> with it.
# Every CHANGE_ME must be filled in; README.md explains the values. The file is read by docker
# compose and sourced by bash, so quote values that contain spaces.

# Both stacks on one box: no public ports, Cloudflare Tunnel per stack (README "Behind a
# Cloudflare Tunnel"). Remove both lines for a single stack on ports 80/443 with Let's Encrypt.
COMPOSE_FILE=docker-compose.yml:docker-compose.tunnel.yml
SITE_SCHEME=http://
# This stack's tunnel config in ./cloudflared (README "Behind a Cloudflare Tunnel").
CLOUDFLARED_CONFIG=config-qa.yml

# Hosts of this stack (one subdomain level: terra-qa-app.example.com, not app.qa.example.com).
APP_DOMAIN=terra-qa-app.example.com
API_DOMAIN=terra-qa-api.example.com
SITE_DOMAIN=terra-qa.example.com
IMG_DOMAIN=terra-qa-img.example.com
S3_DOMAIN=terra-qa-s3.example.com

# Data of this stack: PostgreSQL + Temporal (TERRA_DB_DIR), media bucket + daily dumps
# (TERRA_POOL_DIR). Must differ between .env.qa and .env.prod (the deploy refuses otherwise).
TERRA_DB_DIR=/home/ol1n/terra/qa/db
TERRA_POOL_DIR=/home/ol1n/terra/qa/pool
# Image tag of this stack's builds (terra/api:<tag> ...), one per profile.
TERRA_TAG=qa
# uid that owns TERRA_POOL_DIR and ./cloudflared (backup and cloudflared containers run as it).
BACKUP_UID=1000

# Secrets: openssl rand -hex 32 for each.
POSTGRES_PASSWORD=CHANGE_ME_hex32
TERRA_API_DB_PASSWORD=CHANGE_ME_hex32
CENTRIFUGO_API_KEY=CHANGE_ME_hex32
CENTRIFUGO_TOKEN_SECRET=CHANGE_ME_hex32
APP_SECRET_KEY=CHANGE_ME_hex32_at_least_32_characters
IMGPROXY_KEY=CHANGE_ME_hex32
IMGPROXY_SALT=CHANGE_ME_hex32
S3_ACCESS_KEY=CHANGE_ME_hex32
S3_SECRET_KEY=CHANGE_ME_hex32

# Media: the api, web and browser reach the bucket through the public S3_DOMAIN (presigned URLs
# are signed for that host); imgproxy through IMG_DOMAIN.
S3_ENDPOINT=${S3_DOMAIN}
S3_USE_SSL=true
IMGPROXY_URL=https://${IMG_DOMAIN}
CSP_MEDIA_ORIGINS="https://${IMG_DOMAIN} https://${S3_DOMAIN}"
# IMGPROXY_URL_TTL=168h

# App links (docs/runbooks/launch.md §8); empty renders placeholders.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=

# Mail: empty SMTP_ADDR = mails only logged (sign-in is by e-mail link, so testers need real mail).
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@terrareality.cz

# AiStack gateway on the Spark over the LAN; empty = mock mode.
LLM_BASE_URL=
# PUSH_PROVIDER=log
# PHONE_VERIFICATION=false
# SESSION_MAX_AGE=2160h
# BACKUP_KEEP_DAYS=14
