# Public entry point for staging. TLS via Let's Encrypt, or plain HTTP behind a Cloudflare Tunnel
# (SITE_SCHEME=http://, docker-compose.tunnel.yml). Same header baseline and access-log redaction
# as production (infra/hetzner/compose/Caddyfile); keep the snippets in sync.

{
	servers {
		# Behind the tunnel the client is cloudflared on the compose network; Cloudflare puts the
		# visitor's address in Cf-Connecting-Ip. Direct visitors come from public addresses, which
		# are not trusted, so the header cannot be spoofed on the port-80/443 setup either.
		trusted_proxies static private_ranges
		client_ip_headers Cf-Connecting-Ip
	}
}

(security_headers) {
	header {
		defer
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
		?Cross-Origin-Opener-Policy "same-origin"
		# Staging must never be indexed.
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
	}
}

(access_log) {
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "(/v1/invitations/)[^/?]+|(\?).*" "${1}${2}REDACTED"
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>User-Agent delete
				request>headers>Referer delete
			}
		}
	}
}

(common) {
	encode zstd gzip
	import security_headers
	import access_log
	@internal path /metrics /metrics/* /debug/* /dev/*
	respond @internal 404
}

# Strict CSP for the static Astro site (review S-W, "Astro web bez CSP"). The build ships no
# JavaScript (JSON-LD blocks are data, not executed), one stylesheet from /_astro and the inline SVG
# logo whose size comes from a `style="--size: ..."` attribute (hence style-src-attr only). Links to
# the app domain are plain navigations, which CSP does not restrict. Re-check with
# `npm run build -w site` + grep for <script/<style/style= when the site gains islands or images.
(site_csp) {
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
}

# Android App Links + iOS Universal Links for the mobile app (cz.terrareality.terrareality) on the
# site and app hosts (docs/runbooks/launch.md section 8). The templates live in
# apps/web/static/.well-known (mounted at /srv/app-links/.well-known) and are rendered with the
# Caddy env APPLE_TEAM_ID and ANDROID_CERT_SHA256 (comma-separated SHA-256 fingerprints: Play app
# signing key, optionally the upload key). Served directly with Content-Type application/json and
# status 200: no redirect, no proxying (Apple and Google reject both).
(app_links) {
	@app_links path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @app_links {
		root * /srv/app-links
		header Content-Type application/json
		header Cache-Control "public, max-age=3600"
		templates {
			mime application/json
		}
		file_server
	}
}

{$SITE_SCHEME}{$APP_DOMAIN} {
	import common
	import app_links
	request_body {
		max_size 64MB
	}
	reverse_proxy /connection/* centrifugo:8000
	reverse_proxy web:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

{$SITE_SCHEME}{$API_DOMAIN} {
	import common
	request_body {
		max_size 50MB
	}
	reverse_proxy api:8080 {
		lb_try_duration 10s
		header_up X-Forwarded-For {client_ip}
	}
}

{$SITE_SCHEME}{$SITE_DOMAIN} {
	import common
	import site_csp
	import app_links
	root * /srv/site
	file_server
}

# Signed image variants (imgproxy reads the private media bucket)
{$SITE_SCHEME}{$IMG_DOMAIN} {
	import security_headers
	import access_log
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy imgproxy:8080
}

# Media bucket: presigned GET/PUT only (the bucket is private; requests carry a SigV4 signature
# over this host name, so Caddy keeps the Host header as is).
{$SITE_SCHEME}{$S3_DOMAIN} {
	import security_headers
	import access_log
	request_body {
		max_size 64MB
	}
	reverse_proxy s3:8333
}
