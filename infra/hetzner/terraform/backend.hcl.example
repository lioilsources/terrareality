# Remote state on a separate Object Storage bucket (create it once by hand).
# terraform init -backend-config=backend.hcl
bucket                      = "terrareality-tfstate"
key                         = "prod/terraform.tfstate"
region                      = "fsn1"
endpoints                   = { s3 = "https://fsn1.your-objectstorage.com" }
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
use_path_style              = true
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars (Object Storage keys).
