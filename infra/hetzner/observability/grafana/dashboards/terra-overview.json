        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "timeseries",
      "title": "Last backup / WAL archive age",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "id": 22,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "time() - max by (type) (pgbackrest_last_backup_timestamp_seconds)",
          "legendFormat": "backup {{type}}"
