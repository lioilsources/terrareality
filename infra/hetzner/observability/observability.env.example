# Copy to observability.env on the app VM (never commit the real file).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001
# File holding the SMTP password for Alertmanager e-mail (see alertmanager/alertmanager.yml).
ALERT_SMTP_PASSWORD_FILE=/etc/terrareality/secrets/alert_smtp_password
