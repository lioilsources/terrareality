# Copy to observability.env on the app VM (never commit the real file).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=http://localhost:3001
# Directory (root:deploy 0750, files 0640) with the Alertmanager secrets, one value per file without
# a trailing newline: smtp_password, page_webhook_url (see alertmanager/alertmanager.yml).
ALERT_SECRETS_DIR=/etc/terrareality/secrets/alertmanager
