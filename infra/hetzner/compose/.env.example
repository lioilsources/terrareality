# Production environment of the APP VM for infra/hetzner/compose. Copy to .env on the app VM
# (chmod 600, owned by deploy) and fill in. NEVER commit the real file.
# The DB VM has its own .env from db.env.example (review V-16): the app VM never holds the
# pgBackRest keys/cipher pass, the media replica keys or the monitoring password.
# Quote values with spaces ("..."): runbooks source this file with bash.
# Values in <angle brackets> are placeholders. Generate secrets with
#   openssl rand -hex 32

# --- Images (CI `images` job pushes terra/api, terra/web, terra/vision) ---
IMAGE_REGISTRY=ghcr.io/<org>
IMAGE_TAG=<git-sha>

# --- Domains (DNS A/AAAA -> terraform output app_public_ipv4/ipv6) ---
SITE_DOMAIN=terrareality.cz
APP_DOMAIN=app.terrareality.cz
API_DOMAIN=api.terrareality.cz
IMG_DOMAIN=img.terrareality.cz
ACME_EMAIL=<ops@terrareality.cz>
# Static Astro build (apps/site/dist) synced to the app VM
SITE_DIST_DIR=/srv/site

# --- Database (DB VM, private network) ---
DB_HOST=10.10.1.20
# TLS to PostgreSQL (scripts/pg-tls-init.sh on the DB VM writes the CA; copy its ca.crt here).
# verify-full by default; disable only for the first start of a DB VM without the certificate.
DB_SSLMODE=verify-full
PG_CA_FILE=/etc/terrareality/secrets/pg-ca.crt
POSTGRES_USER=terra
# Owner/superuser: only the migrate one-shot gets it (MIGRATE_DATABASE_URL).
POSTGRES_PASSWORD=<openssl rand -hex 32>
# Login role of the api and worker (DATABASE_URL), IN ROLE terra_service, no superuser,
# no BYPASSRLS. Created by initdb/13-api-role.sh; on an existing cluster see deploy.md.
TERRA_API_DB_PASSWORD=<openssl rand -hex 32>
TEMPORAL_DB_PASSWORD=<openssl rand -hex 32>

# --- Go api / worker ---
LOG_LEVEL=info
APP_SECRET_KEY=<openssl rand -hex 32>
# Key rotation only (docs/runbooks/key-rotation.md): previous APP_SECRET_KEY values, comma-separated,
# newest first. They still decrypt/verify but never encrypt/sign; remove after `terractl rotate-secrets`
# and the grace period. Empty in normal operation.
APP_SECRET_KEY_PREVIOUS=
CENTRIFUGO_API_KEY=<openssl rand -hex 32>
CENTRIFUGO_TOKEN_SECRET=<openssl rand -hex 32>
FEATURE_FLAGS=
OTEL_TRACES_SAMPLER_ARG=0.2

# --- LLM: AiStack gateway on the DGX Spark through WireGuard (infra/hetzner/wireguard) ---
# Empty = mock mode. Routes are down 07:00-13:00 (ComfyUI window); jobs retry.
LLM_BASE_URL=http://10.66.0.2:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=openclaw-default
EMBEDDINGS_MODEL=
VISION_MODEL=vl

# --- Identity ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
BANKID_ISSUER=https://oidc.bankid.cz/
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=
BANKID_SCOPES=
TERMS_VERSION=
PRIVACY_VERSION=
# Breached-password check (ASVS V2.1.7): hibp = Have I Been Pwned range API (only a 5-character
# SHA-1 prefix leaves the server, padded responses, fail-open if unreachable) | local | off.
PWNED_PASSWORDS=hibp
# Absolute session lifetime regardless of activity (ASVS V3.3.2); caps SESSION_TTL_WEB/MOBILE.
# 2160h keeps the documented 90-day mobile session; a value below a TTL is warned about at start.
SESSION_MAX_AGE=2160h

# --- Delivery ---
SMTP_ADDR=<smtp-relay-host>:587
MAIL_FROM=no-reply@terrareality.cz
# SMTP PLAIN auth for the relay (empty = none)
SMTP_USERNAME=
SMTP_PASSWORD=
SMS_PROVIDER=log
# Phone verification stays off until a real SMS adapter exists (true with SMS_PROVIDER=log is refused).
PHONE_VERIFICATION=false
PUSH_PROVIDER=fcm
# Host path of the FCM service account JSON (mounted as a Docker secret)
FCM_CREDENTIALS_HOST_FILE=/etc/terrareality/secrets/fcm.json
FCM_PROJECT_ID=
# Set explicitly and never rotate together with APP_SECRET_KEY: a new seed invalidates every browser
# push subscription (the api refuses to start with APP_SECRET_KEY_PREVIOUS but no seed).
WEBPUSH_VAPID_SEED=<openssl rand -hex 32>
WEBPUSH_SUBJECT=mailto:podpora@terrareality.cz

# --- Object storage for media (Hetzner, S3 compatible) ---
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=terrareality-media
S3_ACCESS_KEY=<object-storage-access-key>
S3_SECRET_KEY=<object-storage-secret-key>
IMGPROXY_KEY=<openssl rand -hex 32>
IMGPROXY_SALT=<openssl rand -hex 32>
# Key rotation only: what the imgproxy container accepts, "new,old" (same order for keys and salts).
# Empty = IMGPROXY_KEY / IMGPROXY_SALT. The api always signs with IMGPROXY_KEY / IMGPROXY_SALT.
IMGPROXY_VERIFY_KEYS=
IMGPROXY_VERIFY_SALTS=

# --- Applications / leasing ---
ISIR_MODE=live
LEASE_TEMPLATES_REVIEWED=false
BANK_PROVIDER=gocardless
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Billing (M7): Stripe for platform services only (ADR 0002) ---
# Webhook endpoint: https://api.terrareality.cz/v1/webhooks/stripe
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Revolut Business Merchant: per-landlord API keys are stored (sealed) in the DB; this is the API base.
REVOLUT_API_URL=https://merchant.revolut.com
# Supplier data printed on platform invoices
PLATFORM_LEGAL_NAME="<TerraReality s.r.o.>"
PLATFORM_ICO=<12345678>
PLATFORM_DIC=<CZ12345678>
PLATFORM_ADDRESS="<street, city, zip>"
PLATFORM_IBAN="<CZ6508000000192000145399>"

# --- Web (SvelteKit) ---
# The web refuses to start in production without its browser-facing origins (CSP). Compose derives
# them from the domains above; override only if the media or realtime hosts differ:
#   CSP_MEDIA_ORIGINS        img-src/form-action: https://$IMG_DOMAIN + the S3 endpoint (presigned downloads)
#   CSP_FORM_ACTION_ORIGINS  Stripe Checkout, Revolut, GoCardless bank consent, BankID
#   CSP_REALTIME_ORIGIN      wss://$APP_DOMAIN (Centrifugo behind Caddy)
#   CSP_MAP_ORIGINS          extra tile/glyph hosts if MAP_STYLE points elsewhere than OpenFreeMap
CSP_MEDIA_ORIGINS=
CSP_FORM_ACTION_ORIGINS=
CSP_REALTIME_ORIGIN=
CSP_MAP_ORIGINS=
# Request body limit of the SvelteKit server (uploads go through form actions; adapter-node
# default 512K). Caddy allows 64MB on the app domain.
WEB_BODY_SIZE_LIMIT=60M
MAP_STYLE=
SENTRY_DSN=
PUBLIC_SENTRY_DSN=

# --- Temporal images (verify tags before the first deploy) ---
# TEMPORAL_SERVER_IMAGE=temporalio/server:1.28.1
# TEMPORAL_ADMIN_TOOLS_IMAGE=temporalio/admin-tools:1.28.1-tctl-1.18.4-cli-1.4.1
