# Production entry point on the app VM. Automatic HTTPS (Let's Encrypt, ZeroSSL
# fallback) for every site block; HTTP redirects to HTTPS. HTTP/3 enabled.
# CSP is set by the apps themselves (security baseline below is transport-level).
{
	email {$ACME_EMAIL}
	log {
		format json
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

(common) {
	encode zstd gzip
	import security_headers
	log
	# Internal endpoints never leave the VM.
	@internal path /metrics /metrics/* /debug/*
	respond @internal 404
}

# Marketing + SEO site (static Astro build)
{$SITE_DOMAIN} {
	import common
	root * /srv/site
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Web app (SvelteKit) + Centrifugo websocket
{$APP_DOMAIN} {
	import common
	handle /connection/* {
		reverse_proxy centrifugo:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Public API (browsers, Flutter app, Stripe webhooks)
{$API_DOMAIN} {
	import common
	request_body {
		max_size 50MB
	}
	# Stripe webhooks: signed payload, must reach the api byte for byte (no
	# compression or rewriting on the request side). Rate limited in the api.
	handle /v1/webhooks/stripe {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy api:8080 {
			health_uri /healthz
			health_interval 15s
		}
	}
}

# Signed image variants (imgproxy reads the private media bucket)
{$IMG_DOMAIN} {
	import security_headers
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy imgproxy:8080
}
