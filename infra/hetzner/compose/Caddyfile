# Production entry point on the app VM. Automatic HTTPS (Let's Encrypt, ZeroSSL
# fallback) for every site block; HTTP redirects to HTTPS. HTTP/3 enabled.
# CSP is set by the apps themselves (security baseline below is transport-level); the static site
# gets its fixed CSP from the site_csp snippet.
{
	email {$ACME_EMAIL}
	log {
		format json
	}
}

# Transport-level header baseline. `?` sets a header only when the upstream did not send it, so the
# api (internal/platform/httpx/security.go: HSTS 2 years, Referrer-Policy no-referrer, stricter
# Permissions-Policy) and the web (hooks.server.ts) keep their own values and no response carries
# two different copies of the same header. `defer` applies the operations after the upstream
# answered (required for `?` and for stripping upstream Server/X-Powered-By).
(security_headers) {
	header {
		defer
		?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=()"
		?Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
}

# Access log without personal data beyond what operations need (ASVS 7.1, review S-A2):
# - query strings are replaced by "?REDACTED" (magic-link, e-mail verification and password reset
#   tokens travel in the query), invitation tokens in the path become /v1/invitations/REDACTED;
# - client IPs are truncated to /24 (IPv4) and /48 (IPv6); User-Agent is not logged.
# Cookie/Authorization are never logged by Caddy. Loki keeps Caddy logs 14 days (loki.yml).
(access_log) {
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "(/v1/invitations/)[^/?]+|(\?).*" "${1}${2}REDACTED"
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>User-Agent delete
				request>headers>Referer delete
			}
		}
	}
}

(common) {
	encode zstd gzip
	import security_headers
	import access_log
	# Internal endpoints never leave the VM (/dev/* = mock providers, refused in prod anyway).
	@internal path /metrics /metrics/* /debug/* /dev/*
	respond @internal 404
}

# Strict CSP for the static Astro site (review S-W, "Astro web bez CSP"). The build ships no
# JavaScript (JSON-LD blocks are data, not executed), one stylesheet from /_astro and the inline SVG
# logo whose size comes from a `style="--size: ..."` attribute (hence style-src-attr only). Links to
# the app domain are plain navigations, which CSP does not restrict. Re-check with
# `npm run build -w site` + grep for <script/<style/style= when the site gains islands or images.
(site_csp) {
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
}

# Android App Links + iOS Universal Links for the mobile app (cz.terrareality.terrareality) on the
# site and app hosts (docs/runbooks/launch.md section 8). The templates live in
# apps/web/static/.well-known (mounted at /srv/app-links/.well-known) and are rendered with the
# Caddy env APPLE_TEAM_ID and ANDROID_CERT_SHA256 (comma-separated SHA-256 fingerprints: Play app
# signing key, optionally the upload key). Served directly with Content-Type application/json and
# status 200: no redirect, no proxying (Apple and Google reject both).
(app_links) {
	@app_links path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @app_links {
		root * /srv/app-links
		header Content-Type application/json
		header Cache-Control "public, max-age=3600"
		templates {
			mime application/json
		}
		file_server
	}
}

# Marketing + SEO site (static Astro build)
{$SITE_DOMAIN} {
	import common
	import site_csp
	import app_links
	root * /srv/site
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/index.html {path}.html
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Web app (SvelteKit) + Centrifugo websocket
{$APP_DOMAIN} {
	import common
	import app_links
	# Uploads go through SvelteKit form actions; slightly above BODY_SIZE_LIMIT=60M (MiB) of the web.
	request_body {
		max_size 64MB
	}
	handle /connection/* {
		reverse_proxy centrifugo:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Public API (browsers, Flutter app, Stripe webhooks)
{$API_DOMAIN} {
	import common
	request_body {
		max_size 50MB
	}
	# Stripe webhooks: signed payload, must reach the api byte for byte (no
	# compression or rewriting on the request side). Rate limited in the api.
	handle /v1/webhooks/stripe {
		reverse_proxy api:8080 {
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
	handle {
		# Single upstream: no active health check on /healthz (it turns 503 when a dependency such as
		# vision or the worker heartbeat is degraded, and Caddy would then drop *every* route). The
		# liveness probe is /v1/version (answers whenever the process serves HTTP); lb_try_duration
		# holds requests for a few seconds while the api restarts during a deploy instead of 502.
		reverse_proxy api:8080 {
			health_uri /v1/version
			health_interval 15s
			health_timeout 3s
			health_fails 3
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}
}

# Signed image variants (imgproxy reads the private media bucket)
{$IMG_DOMAIN} {
	import security_headers
	import access_log
	header Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy imgproxy:8080
}
