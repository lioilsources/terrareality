# Production environment of the DB VM for infra/hetzner/compose (docker-compose.db.yml, backup and
# media replica scripts). Copy to .env on the DB VM (chmod 600, owned by deploy) and fill in.
# NEVER commit the real file. The app VM has its own .env from .env.example (review V-16): only
# this file holds the pgBackRest keys and cipher pass and the media replica keys.
# Quote values with spaces ("..."): scripts source this file with bash.

# --- Database ---
DB_BIND_IP=10.10.1.20
# Same values as in the app VM .env (initdb creates the roles with them).
POSTGRES_PASSWORD=<openssl rand -hex 32>
TERRA_API_DB_PASSWORD=<openssl rand -hex 32>
TEMPORAL_DB_PASSWORD=<openssl rand -hex 32>
# postgres_exporter (runs on this VM only)
MONITORING_DB_PASSWORD=<openssl rand -hex 32>
PGDATA_DIR=/srv/pgdata
PGBACKREST_SPOOL_DIR=/srv/pgbackrest-spool
# Server certificate (scripts/pg-tls-init.sh); empty directory = PostgreSQL without TLS.
PG_TLS_DIR=/srv/pgtls

# --- pgBackRest: repository in the SEPARATE backup project (own Hetzner project, own S3 keys) ---
# Terraform output backup_bucket / backup_endpoint (provider minio.backup). Bucket versioning with
# noncurrent-version expiry protects against overwrite/delete through these keys (backup.md).
PGBACKREST_BUCKET=terrareality-pgbackrest
PGBACKREST_S3_ENDPOINT=fsn1.your-objectstorage.com
PGBACKREST_S3_REGION=fsn1
PGBACKREST_S3_KEY=<backup-project-access-key>
PGBACKREST_S3_KEY_SECRET=<backup-project-secret-key>
# Losing this passphrase makes every backup unreadable: store it in the password manager AND offline.
PGBACKREST_CIPHER_PASS=<openssl rand -base64 48>

# --- Media replica: second copy of the media bucket in another location ---
# scripts/media-replicate.sh (timer terra-media-replicate, hourly). Source = the media bucket of
# the app project (S3_* below, same values as on the app VM); target = the replica bucket in the
# backup project. Terraform outputs media_replica_endpoint / media_replica_bucket.
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=terrareality-media
S3_ACCESS_KEY=<app-project-object-storage-access-key>
S3_SECRET_KEY=<app-project-object-storage-secret-key>
MEDIA_REPLICA_ENDPOINT=nbg1.your-objectstorage.com
MEDIA_REPLICA_REGION=nbg1
MEDIA_REPLICA_BUCKET=terrareality-media-replica
# Keys of the backup project. Required: media-replicate.sh refuses to run with empty keys or the
# media keys (a leaked app key must not be able to delete the copy). Drills only:
# MEDIA_REPLICA_ALLOW_SHARED_KEYS=1.
MEDIA_REPLICA_ACCESS_KEY=<backup-project-access-key>
MEDIA_REPLICA_SECRET_KEY=<backup-project-secret-key>
# Deleted/overwritten objects stay under _replica-archive/<stamp>/ this many days.
MEDIA_REPLICA_RETENTION_DAYS=90
# Mass-delete guards: abort (and alert) instead of mirroring the deletion.
MEDIA_REPLICA_MAX_DELETE=500
MEDIA_REPLICA_MAX_SHRINK_PERCENT=10
